{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teamconnect-website",
  "compatibility_date": "2026-04-28",
  "main": "src/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teamconnect-disc",
      "database_id": "136e24b8-3f56-4136-9dc3-1229d2589226"
    }
  ]
}
